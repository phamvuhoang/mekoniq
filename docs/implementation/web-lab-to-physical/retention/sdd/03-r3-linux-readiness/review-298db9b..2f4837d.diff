+ ...[7,42,99].map(seed=>({id:`mj-bv01-${seed}`,kind:'business',seed,scope:'unchanged_runtime'})),
+ {id:'bad-state',kind:'bad_state',seed:42,scope:'instrumented_historical_worker'},
