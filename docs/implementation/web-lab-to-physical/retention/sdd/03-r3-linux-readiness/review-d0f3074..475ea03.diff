+test.each(['../outside','/tmp/outside','inputs/../model','inputs\\model','inputs//model'])('rejects unsafe ref %s before reading/copying',async path=>{const f=await fixture();f.manifest.refs.model[0].path=path;expect((await validateNativeHandoff(f.root,f.manifest)).prepared).toBe(false);});
