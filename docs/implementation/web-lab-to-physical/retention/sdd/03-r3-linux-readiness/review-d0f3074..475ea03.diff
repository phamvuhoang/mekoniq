+ if(!isDeepStrictEqual(v.installation,installation))add('HOST_INSTALLATION_MISMATCH','/inventory/installation');
+ if(!isDeepStrictEqual(v.image,s.image))add('HOST_IMAGE_MISMATCH','/inventory/image');
