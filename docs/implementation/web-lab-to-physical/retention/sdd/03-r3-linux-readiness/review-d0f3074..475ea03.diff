+test('rejects oversized sparse archive without loading it',async()=>{const f=await fixture();const a=await f.put('archive','archive.bin','');await truncate(join(f.root,a.path),65*1024*1024);a.bytes=65*1024*1024;expect((await validateNativeHandoff(f.root,f.manifest)).prepared).toBe(false);});
