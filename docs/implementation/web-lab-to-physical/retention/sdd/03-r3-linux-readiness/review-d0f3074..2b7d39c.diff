+  "properties": {
+    "schemaVersion": {
+      "const": 1
+    },
+    "subject": {
+      "$ref": "#/definitions/HandoffSubject"
+    },
+    "checker": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "sourceCommit",
+        "toolSha256"
+      ],
+      "properties": {
+        "sourceCommit": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{40}$"
+        },
+        "toolSha256": {
+          "type": "string",
+          "pattern": "^[a-f0-9]{64}$"
+        }
+      }
+    },
+    "refs": {
+      "type": "object",
+      "additionalProperties": false,
+      "required": [
+        "runtimeManifest",
+        "labLock",
+        "runtime",
+        "project",
+        "world",
+        "model",
+        "profile",
+        "schema",
+        "engine",
+        "tool"
+      ],
+      "properties": {
+        "runtimeManifest": {
+          "type": "array",
+          "minItems": 1,
