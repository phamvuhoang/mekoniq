+  "$id": "native-handoff-v1.schema.json",
+  "title": "NativeHandoffV1",
+  "type": "object",
+  "additionalProperties": false,
+  "required": [
+    "schemaVersion",
+    "subject",
+    "checker",
+    "refs",
+    "profile",
+    "frames",
+    "units",
+    "seeds",
