 test('local inventory collection never infers origin from process.platform',async()=>{const inventory=await collectNativeInventory();expect(inventory.provenance).toMatchObject({origin:'unknown',emulation:'unknown',hostOs:'unknown'});expect(inventory).toMatchObject({schemaVersion:1});});
 test('legacy profile validation stays strict while an explicit locked handoff profile is checked',async()=>{const f=await fixture();expect(validNativeProfileReport(f.inventory,f.manifest.profile.id)).toBe(false);expect(validNativeProfileReport(f.inventory,f.manifest.profile.id,{profile:f.manifest.profile,subject:f.manifest.subject})).toBe(true);f.inventory.modelId='xarm6';expect(validNativeProfileReport(f.inventory,f.manifest.profile.id,{profile:f.manifest.profile,subject:f.manifest.subject})).toBe(false);});
 test.each([null,{}, {requiredPackages:[null]}, {forbiddenPackages:[null]}, {clockDomains:[null]}])('malformed explicit profile expectations are refused without throwing (%j)',async patch=>{const f=await fixture();const profile=patch===null?null:{...f.manifest.profile,...patch};expect(()=>validNativeProfileReport(f.inventory,f.manifest.profile.id,{profile,subject:f.manifest.subject})).not.toThrow();if(patch!==null&&Object.keys(patch).length===0)expect(validNativeProfileReport(f.inventory,f.manifest.profile.id,{profile,subject:f.manifest.subject})).toBe(true);else expect(validNativeProfileReport(f.inventory,f.manifest.profile.id,{profile,subject:f.manifest.subject})).toBe(false);});
 test('Mac-hosted Linux and emulated amd64 cannot substitute for native amd64',async()=>{const f=await fixture();f.inventory.provenance.hostOs='darwin';f.inventory.provenance.virtualization='container';expect((await validateNativeHandoff(f.root,f.manifest,f.inventory)).nativeReady).toBe(false);f.inventory.provenance.hostOs='linux';f.inventory.provenance.hostArchitecture='arm64';f.inventory.provenance.emulation='qemu';expect((await validateNativeHandoff(f.root,f.manifest,f.inventory)).nativeReady).toBe(false);});
 test('native_apt uses matching exact package/source locks without inventing an OCI image',async()=>{const f=await fixture('native_apt');expect(f.manifest.subject.image).toBeNull();expect(await validateNativeHandoff(f.root,f.manifest,f.inventory)).toMatchObject({prepared:true,nativeReady:true,issues:[]});});
 test('native_apt unresolved repository digest is prepared but unready',async()=>{const f=await fixture('native_apt');Object.assign(f.manifest.profile.installation.sources![0],{sha256:null});const bytes=JSON.stringify(f.manifest.profile);const {digest}=await import('../fixtures/native-handoff');Object.assign(f.manifest.refs.profile[0],{sha256:digest(bytes),bytes:Buffer.byteLength(bytes)});f.manifest.subject.profileSha256=digest(bytes);await writeFile(join(f.root,'profile.json'),bytes);expect(await validateNativeHandoff(f.root,f.manifest,f.inventory)).toMatchObject({prepared:true,nativeReady:false});});
 test('native_apt actual repository bytes must match its locked provenance',async()=>{const f=await fixture('native_apt');await writeFile(join(f.root,'apt-release.txt'),'different repository');const r=await validateNativeHandoff(f.root,f.manifest,f.inventory);expect(r.prepared).toBe(true);expect(r.nativeReady).toBe(false);expect(r.issues.map(x=>x.code)).toContain('HOST_PROVENANCE_ARTIFACT_INVALID');});
 test('image-bound subject cannot borrow native_apt profile or relabel away its missing image',async()=>{const f=await fixture(),native=await fixture('native_apt');Object.assign(f.manifest.subject,{image:null});Object.assign(f.manifest.profile,{installation:native.manifest.profile.installation});const bytes=JSON.stringify(f.manifest.profile),{digest}=await import('../fixtures/native-handoff');Object.assign(f.manifest.refs.profile[0],{sha256:digest(bytes),bytes:Buffer.byteLength(bytes)});f.manifest.subject.profileSha256=digest(bytes);await writeFile(join(f.root,'profile.json'),bytes);const r=await validateNativeHandoff(f.root,f.manifest,native.inventory);expect(r.nativeReady).toBe(false);expect(r.issues.map(x=>x.code)).toContain('INSTALLATION_PROFILE_MISMATCH');});
 test('standalone canonical navigation prepares ROS inputs while retaining the missing native engine mapping',async()=>{const f=await nativeHandoffFixture('ros_navigation');dirs.push(f.root);const r=await validateNativeHandoff(f.root,f.manifest,f.inventory);expect(r.prepared).toBe(true);expect(r.nativeReady).toBe(false);expect(r.issues.map(x=>x.code)).toContain('NATIVE_ENGINE_MAPPING_UNRESOLVED');});
 test('canonical xArm preparation cannot claim expanded native ROS model parity',async()=>{const f=await nativeHandoffFixture('ros_xarm');dirs.push(f.root);const r=await validateNativeHandoff(f.root,f.manifest,f.inventory);expect(r.prepared).toBe(true);expect(r.nativeReady).toBe(false);expect(r.issues.map(x=>x.code)).toContain('NATIVE_MODEL_MAPPING_UNRESOLVED');});
