 test.each(['architecture','profileId','modelId','modelSha256'])('inventory %s cannot be borrowed from another profile',async key=>{const f=await fixture();(f.inventory as Record<string,unknown>)[key]='other';expect(await validateNativeHandoff(f.root,f.manifest,f.inventory)).toMatchObject({prepared:true,nativeReady:false});});
 test.each(['origin','hostOs','hostArchitecture','virtualization','emulation'])('unknown/wrong provenance %s never becomes native',async key=>{const f=await fixture();(f.inventory.provenance as Record<string,unknown>)[key]='unknown';expect((await validateNativeHandoff(f.root,f.manifest,f.inventory)).nativeReady).toBe(false);});
 test('unresolved exact locks remain prepared but cannot be native ready',async()=>{const f=await fixture();Object.assign(f.manifest.profile.requiredPackages[0],{version:null,sha256:null});await writeFile(join(f.root,'profile.json'),JSON.stringify(f.manifest.profile));const {digest}=await import('../fixtures/native-handoff');f.manifest.refs.profile[0].sha256=digest(JSON.stringify(f.manifest.profile));f.manifest.refs.profile[0].bytes=Buffer.byteLength(JSON.stringify(f.manifest.profile));f.manifest.subject.profileSha256=f.manifest.refs.profile[0].sha256;expect(await validateNativeHandoff(f.root,f.manifest,f.inventory)).toMatchObject({prepared:true,nativeReady:false});});
 test('unbuilt current image remains distinct from runtime export',async()=>{const f=await fixture();Object.assign(f.manifest.subject,{image:null});Object.assign(f.inventory.subject,{image:null});expect(await validateNativeHandoff(f.root,f.manifest,f.inventory)).toMatchObject({prepared:true,nativeReady:false});});
 test('checker commit may differ while subject receipt cannot',async()=>{const f=await fixture();f.manifest.checker.sourceCommit='9'.repeat(40);expect((await validateNativeHandoff(f.root,f.manifest)).prepared).toBe(true);f.manifest.subject.sourceCommit='8'.repeat(40);expect((await validateNativeHandoff(f.root,f.manifest)).prepared).toBe(false);});
