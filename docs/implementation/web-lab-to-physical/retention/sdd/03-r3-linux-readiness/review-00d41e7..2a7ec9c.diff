+"""Capture/validate actual expanded URDF. Expected projection is static data, never a generated native observation."""
+import hashlib
+import json
+import math
+import xml.etree.ElementTree as ET
+from .policy import ROOT,load_profile
+
+def validate_urdf(xml,mode):
+    if mode not in ('X1','X2') or len(xml)>4_000_000 or any(t in xml.upper() for t in ['<!DOCTYPE','<!ENTITY','<![CDATA[']):raise ValueError('XARM_XML_INVALID')
+    try:robot=ET.fromstring(xml)
+    except ET.ParseError:raise ValueError('XARM_XML_INVALID') from None
+    if robot.tag!='robot':raise ValueError('XARM_XML_INVALID')
+    target=json.loads((ROOT/'profiles/xarm6-native-mapping.json').read_text())
+    def one(node,key):
+        children=node.findall(key)
+        if len(children)!=1:raise ValueError('XARM_MAPPING_INVALID:'+key)
+        return children[0]
+    def near(raw,expected):
+        try:values=[float(x) for x in raw.split()]
+        except (AttributeError,ValueError):raise ValueError('XARM_MAPPING_NUMERIC') from None
+        if len(values)!=len(expected) or any(not math.isfinite(a) or abs(a-b)>1e-9 for a,b in zip(values,expected)):raise ValueError('XARM_MAPPING_MISMATCH')
+    joints=robot.findall('joint');names=[j.get('name') for j in joints];children=[one(j,'child').get('link') for j in joints]
+    if len(set(names))!=len(names) or len(set(children))!=len(children):raise ValueError('XARM_MAPPING_DUPLICATE')
+    for expected in target['joints']:
+        matches=[j for j in joints if j.get('name')==expected['name']]
+        if len(matches)!=1:raise ValueError('XARM_MAPPING_MISMATCH')
+        joint=matches[0]
+        if joint.get('type')!=expected['type'] or one(joint,'parent').get('link')!=expected['parent'] or one(joint,'child').get('link')!=expected['child']:raise ValueError('XARM_MAPPING_MISMATCH')
+        origin=one(joint,'origin');near(origin.get('xyz'),expected['xyz']);near(origin.get('rpy'),expected['rpy'])
+        if 'axis' in expected:
+            near(one(joint,'axis').get('xyz'),expected['axis']);limit=one(joint,'limit')
+            for key,value in expected['limits'].items():near(limit.get(key),[value])
+    links=robot.findall('link')
+    if len({l.get('name') for l in links})!=len(links):raise ValueError('XARM_MAPPING_DUPLICATE')
+    for expected in target['visualMeshes']:
+        matches=[l for l in links if l.get('name')==expected['link']]
+        uri=expected['uri'].replace('package://xarm_description','file://'+load_profile()['descriptionShare']) if mode=='X2' else expected['uri']
+        if len(matches)!=1 or one(one(one(matches[0],'visual'),'geometry'),'mesh').get('filename')!=uri:raise ValueError('XARM_G2_1305_MAPPING_MISMATCH')
+    for expected in target['nominalInertials']:
+        link=next(l for l in links if l.get('name')==expected['link']);inertial=one(link,'inertial');origin=one(inertial,'origin')
+        near(origin.get('xyz'),expected['comM']);near(origin.get('rpy'),[0,0,0]);near(one(inertial,'mass').get('value'),[expected['massKg']]);tensor=one(inertial,'inertia')
+        for key,value in zip(['ixx','ixy','ixz','iyy','iyz','izz'],expected['inertiaKgM2']):near(tensor.get(key),[value])
+    controls=robot.findall('ros2_control')
+    if not controls:raise ValueError('XARM_PLUGIN_MISSING')
+    for control in controls:
+        if one(one(control,'hardware'),'plugin').text.strip()!=load_profile()['modes'][mode]['plugin']:raise ValueError('XARM_HARDWARE_PLUGIN_FORBIDDEN')
+    return {'schemaVersion':1,'mode':mode,'scope':target['scope'],'profileId':load_profile()['id'],'urdfSha256':hashlib.sha256(xml.encode()).hexdigest()}
+
+def produce_mapping(xml,mode,directory,subject=None,evidence_kind="protocol_double",controller=None):
+    subject=subject or {}
+    report=validate_urdf(xml,mode)
+    report.update(producer="native_xarm.robot_description.v1",sourceCommit=subject.get("sourceCommit"),subjectProfileId=subject.get("profileId"),environmentProfile=subject.get("environmentProfile"),sourceModelSha256=json.loads((ROOT/"profiles/xarm6-native-mapping.json").read_text())["sourceModelSha256"],vendorCommit=load_profile()["vendorCommit"],evidenceKind=evidence_kind,syntheticSimModelSelector=load_profile()["syntheticSimModelSelector"])
+    if controller is not None:report["controller"]=controller
+    with (directory/'expanded.urdf').open('x') as f:f.write(xml)
+    with (directory/'mapping.json').open('x') as f:json.dump(report,f,indent=2)
+    return report
diff --git a/robotics/manipulation/native_xarm/policy.py b/robotics/manipulation/native_xarm/policy.py
new file mode 100644
index 0000000..7093b79
--- /dev/null
+++ b/robotics/manipulation/native_xarm/policy.py
@@ -0,0 +1,64 @@
+"""Immutable server launch/trajectory policy. Source pins are not installed package pins."""
+import hashlib
+import json
+import math
+from pathlib import Path
+ROOT=Path(__file__).resolve().parents[1]
+
+def load_profile():return json.loads((ROOT/'profiles/xarm6-jazzy-sim.json').read_text())
+
+def launch_argv(mode):
+    p=load_profile()
+    if mode not in p['modes']:raise ValueError('XARM_MODE_INVALID')
+    args=['ros2','launch','xarm_moveit_config',p['modes'][mode]['launch'],'dof:=6','robot_type:=xarm','model1300:=false','gripper_version:=G2','add_gripper:=true','limited:=false','prefix:=','hw_ns:=xarm','no_gui_ctrl:=true','robot_sn:='+p['syntheticSimModelSelector']]
+    if mode=='X2':args+=['gz_type:=gz']
+    return args
+
+def verify_vendor():
+    lock=json.loads((ROOT/'native-vendor.lock.json').read_text());reasons=[]
+    for f in lock['files']:
+        path=ROOT/'vendor-source'/f['path']
+        if not path.is_file() or path.is_symlink() or hashlib.sha256(path.read_bytes()).hexdigest()!=f['contentSha256']:reasons.append('VENDOR_SOURCE_MISMATCH:'+f['path'])
+    return reasons
+
+def prerequisites():
+    # Source preparation never manufactures a resolved native environment lock.
+    return verify_vendor()+['INVENTORY_UNRESOLVED','PLUGIN_INVENTORY_UNRESOLVED','NATIVE_MAPPING_NOT_OBSERVED']
+
+def map_joints(names,values):
+    wanted=[x['native'] for x in load_profile()['jointMap']]
+    if len(names)!=len(set(names)) or not set(wanted)<=set(names) or len(names)!=len(values) or not all(isinstance(v,(float,int)) and not isinstance(v,bool) and math.isfinite(v) for v in values):raise ValueError('JOINT_FEEDBACK_INVALID')
+    return [values[names.index(n)] for n in wanted]
+
+def validate_trajectory(points,actual):
+    p=load_profile();policy=p['trajectory']
+    if not isinstance(points,list) or not 1<=len(points)<=policy['maxPoints'] or len(actual)!=6:raise ValueError('TRAJECTORY_INVALID')
+    previous=actual;time=0
+    for point in points:
+        if set(point)!={'positions','timeS'}:raise ValueError('TRAJECTORY_INVALID')
+        q=point['positions'];t=point['timeS']
+        if not isinstance(q,list) or len(q)!=6 or not all(isinstance(v,(int,float)) and not isinstance(v,bool) and math.isfinite(v) for v in [*q,t]) or not time<t<=policy['maxDurationS']:raise ValueError('TRAJECTORY_INVALID')
+        for i,v in enumerate(q):
+            limit=p['jointMap'][i]['limits']
+            if not limit['lower']<=v<=limit['upper'] or abs(v-previous[i])/(t-time)>min(policy['maxVelocityRadS'],limit['velocity']):raise ValueError('TRAJECTORY_LIMIT')
+        previous=q;time=t
+
+def assess_contact(evidence):
+    reasons=[];trials=evidence.get('trials',[])
+    if evidence.get('evidenceKind')!='gazebo_actual':reasons.append('CONTACT_NATIVE_REQUIRED')
+    if len(trials)!=10 or len({t.get('id') for t in trials})!=10:reasons.append('TEN_DISTINCT_TRIALS_REQUIRED')
+    for t in trials:
+        if not all(t.get(k) is True for k in ['grip','release','supportObserved','receiverObserved']):reasons.append('CONTACT_OUTCOME_MISSING')
+        for k in ['collisionExclusionsSha256','rawObservationsSha256','mappingSha256']:
+            value=t.get(k,'')
+            if not isinstance(value,str) or len(value)!=64 or any(c not in '0123456789abcdef' for c in value):reasons.append('CONTACT_PROVENANCE_MISSING')
+    # Structural evidence alone cannot clear the unresolved installed G2 plugin and native readback gates.
+    reasons.append(load_profile()['contact']['reason'])
+    return {'result':'not_run','blockers':sorted(set(reasons)),'accepted':False,'dynamics':'not_calibrated'}
+
+
+def decode_sim_selector(value):
+    """Explain the pinned upstream decoder branch; never a device identity validator."""
+    if len(value)!=14 or not value.startswith('XI') or value[11]!='B':raise ValueError('SIM_SELECTOR_INVALID')
+    model=int(value[2:6]);date=int(value[8:10]+value[6:8]);mass=11 if date>=2004 else 1
+    return {'modelNum':model,'modelType':6,'dateCode':date,'massType':mass,'inertialFile':'xarm6_type6_HT_BR2' if mass==11 else 'xarm6_type6_HT_BR'}
diff --git a/robotics/manipulation/native_xarm/ros.py b/robotics/manipulation/native_xarm/ros.py
new file mode 100644
index 0000000..bfea7ef
--- /dev/null
+++ b/robotics/manipulation/native_xarm/ros.py
@@ -0,0 +1,118 @@
+"""Jazzy FollowJointTrajectory client with independent controller/joint/TCP readback.
+Imports ROS only after host admission. No IP, hardware driver, shell or user-supplied action exists here.
+"""
+import math
+import threading
+import time
+from .policy import load_profile,map_joints
+
+class RosPort:
+    def __init__(self,mode,boot_id,emit):
+        import rclpy
+        from control_msgs.action import FollowJointTrajectory
+        from control_msgs.msg import JointTrajectoryControllerState
+        from trajectory_msgs.msg import JointTrajectoryPoint
+        from sensor_msgs.msg import JointState
+        from rosgraph_msgs.msg import Clock
+        from rclpy.action import ActionClient
+        from rclpy.executors import SingleThreadedExecutor
+        from rclpy.parameter import Parameter
+        from tf2_ros import Buffer,TransformListener
+        if not rclpy.ok():rclpy.init()
+        self.node=rclpy.create_node('mekoniq_xarm_observer');self.node.set_parameters([Parameter('use_sim_time',value=mode=='X2')])
+        self.mode=mode;self.boot_id=boot_id;self.emit=emit;self.seq=0;self.controller_identity=None;self.clock=None;self.clock_receipt=None;self.joints=None;self.controller=None;self.session=None;self.fatal=None
+        self.evidence_kind=load_profile()['modes'][mode]['evidenceKind'];self.Goal=FollowJointTrajectory.Goal;self.Point=JointTrajectoryPoint
+        self.client=ActionClient(self.node,FollowJointTrajectory,load_profile()['action']);self.handle=None;self.result_future=None
+        self.tf=Buffer();self.listener=TransformListener(self.tf,self.node);self.tf_receipt=None
+        from tf2_msgs.msg import TFMessage
+        def transforms(msg):
+            for t in msg.transforms:
+                if t.child_frame_id=='link_tcp':self.tf_receipt=time.monotonic_ns()
+        self.node.create_subscription(TFMessage,'/tf',transforms,10)
+        self.node.create_subscription(JointState,'/joint_states',self.on_joints,10)
+        self.node.create_subscription(JointTrajectoryControllerState,'/xarm6_traj_controller/controller_state',self.on_controller,10)
+        self.node.create_subscription(Clock,'/clock',self.on_clock,10)
+        self.executor=SingleThreadedExecutor();self.executor.add_node(self.node);self.thread=threading.Thread(target=self.executor.spin,daemon=True);self.thread.start()
+
+    def on_clock(self,msg):
+        value=msg.clock.sec*1_000_000_000+msg.clock.nanosec
+        if self.clock is not None and value<self.clock:self.fatal='CLOCK_RESET'
+        if value!=self.clock:self.clock_receipt=time.monotonic_ns()
+        self.clock=value
+
+    def on_joints(self,msg):self.joints=(msg,time.monotonic_ns())
+    def on_controller(self,msg):self.controller=(msg,time.monotonic_ns())
+
+    def sample(self):
+        from rclpy.time import Time
+        now=time.monotonic_ns();clock=self.clock if self.mode=='X2' else self.node.get_clock().now().nanoseconds
+        if self.fatal:raise RuntimeError(self.fatal)
+        publishers=self.node.get_publishers_info_by_topic('/xarm6_traj_controller/controller_state')
+        if len(publishers)!=1:raise RuntimeError('CONTROLLER_IDENTITY_MISSING')
+        identity=tuple(publishers[0].endpoint_gid)
+        if self.controller_identity is not None and identity!=self.controller_identity:self.fatal='CONTROLLER_RESTART';raise RuntimeError(self.fatal)
+        self.controller_identity=identity
+        if self.mode=='X2' and (self.clock_receipt is None or now-self.clock_receipt>500_000_000):raise RuntimeError('CLOCK_STALE')
