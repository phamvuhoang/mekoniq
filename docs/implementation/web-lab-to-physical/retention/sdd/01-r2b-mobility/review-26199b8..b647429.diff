+    scene["engine"]["loadProfileRef"].update(id=profile["id"], revision=profile["revision"], path=load+".json", sha256=hashlib.sha256((FIXTURE/(load+".json")).read_bytes()).hexdigest())
+    scene["sceneDigest"] = scene_digest_of(scene)
