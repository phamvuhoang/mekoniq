+import {gunzipSync} from 'node:zlib';
+import {hashJson} from '../hash';
+import {validatePhysicsEvidenceShape,type PhysicsTickRecord} from '../navigation2d/contracts';
+import type {ControlRecord} from '../navigation2d/evidence';
