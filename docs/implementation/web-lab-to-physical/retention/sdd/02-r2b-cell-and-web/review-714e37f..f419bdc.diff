@@ -0,0 +1,7 @@
+# Persistent single-host simulation runtime
+
+This profile is reviewable deployment configuration, not a deployment or qualification. Follow [the operations runbook](../../../docs/operations/lab-runtime-single-host.md). Set operator-owned environment values (runtime image digest, nginx image digest, access key, exact public Host and HTTPS Origin), and provide `tls/fullchain.pem` and `tls/privkey.pem` readable by uid 101. Never commit certificates, private keys or an environment file.
+
+The runtime has one local named volume at `/data/runs`, no published port, no devices or Docker socket, and no automatic restart. A second instance sharing the volume refuses startup while the first holds its SQLite lease. The TLS proxy forwards only the configured exact Host, disables SSE buffering, and serves `/lab/v2/` only. `docker compose config --quiet` validates interpolation without printing secrets. Running `up` is an external deployment step requiring the assigned destination and authorization.
+
+Use a trusted nginx image containing `envsubst`, `/bin/sh`, nginx and uid 101; pin its digest in `LAB_PROXY_IMAGE`. The proxy profile is untested until an actual image/TLS destination is assigned. Local Docker on a Mac would qualify only that Linux VM architecture, never native amd64 or public HTTPS.
diff --git a/deploy/lab-runtime/single-host/compose.yaml b/deploy/lab-runtime/single-host/compose.yaml
new file mode 100644
index 0000000..5b6ea2c
--- /dev/null
+++ b/deploy/lab-runtime/single-host/compose.yaml
@@ -0,0 +1,46 @@
+# One host, local Docker named volume, exactly one runtime. No hardware or daemon mounts.
+services:
+  runtime:
+    image: ${LAB_RUNTIME_IMAGE:?Set an immutable built runtime image digest}
+    restart: "no"
+    read_only: true
+    init: true
+    user: "1000:1000"
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
+    tmpfs: [/tmp:rw,nosuid,nodev,noexec,size=512m]
+    environment:
+      PORT: "8080"
+      LAB_DATA_DIR: /data/runs
+      MEKONIQ_LAB_ACCESS_KEY: ${MEKONIQ_LAB_ACCESS_KEY:?Set a private key of at least 32 characters}
+      LAB_PUBLIC_HOST: ${LAB_PUBLIC_HOST:?Set the exact public Host}
+      LAB_ALLOW_ORIGIN: ${LAB_ALLOW_ORIGIN:?Set the exact HTTPS Lab origin}
+    volumes: [runs:/data/runs]
+    expose: ["8080"]
+    stop_grace_period: 60s
+    healthcheck:
+      test: [CMD, node, -e, "fetch('http://127.0.0.1:8080/lab/v2/health').then(r=>process.exit(r.ok?0:1)).catch(()=>process.exit(1))"]
+      interval: 15s
+      timeout: 5s
+      retries: 3
+  proxy:
+    image: ${LAB_PROXY_IMAGE:?Set an immutable nginx image digest with envsubst}
+    restart: "no"
+    user: "101:101"
+    read_only: true
+    cap_drop: [ALL]
+    security_opt: [no-new-privileges:true]
+    tmpfs: [/tmp:rw,nosuid,nodev,noexec,size=32m]
+    environment:
+      LAB_PUBLIC_HOST: ${LAB_PUBLIC_HOST:?Set the exact public Host}
+    entrypoint: [/bin/sh, -c]
+    command: ['envsubst ''$$LAB_PUBLIC_HOST'' < /etc/nginx/proxy.template > /tmp/nginx.conf && exec nginx -c /tmp/nginx.conf -g ''daemon off;''']
+    volumes:
+      - ./proxy.conf:/etc/nginx/proxy.template:ro
+      - ./tls:/etc/nginx/tls:ro
+    ports: ["443:8443"]
+    depends_on:
+      runtime: {condition: service_healthy}
+    stop_grace_period: 10s
+volumes:
+  runs:
diff --git a/deploy/lab-runtime/single-host/proxy.conf b/deploy/lab-runtime/single-host/proxy.conf
new file mode 100644
index 0000000..f3b55b7
--- /dev/null
+++ b/deploy/lab-runtime/single-host/proxy.conf
@@ -0,0 +1,35 @@
+pid /tmp/nginx.pid;
+error_log /dev/stderr warn;
+events { worker_connections 512; }
+http {
+  access_log off; # bearer/key never logged; request URLs are not authentication channels
+  client_body_temp_path /tmp/body;
+  proxy_temp_path /tmp/proxy;
+  server {
+    listen 8443 ssl;
+    server_name _;
+    ssl_certificate /etc/nginx/tls/fullchain.pem;
+    ssl_certificate_key /etc/nginx/tls/privkey.pem;
+    ssl_protocols TLSv1.2 TLSv1.3;
+    if ($http_host != "${LAB_PUBLIC_HOST}") { return 444; }
+    client_max_body_size 2m;
+    client_header_timeout 10s;
+    client_body_timeout 15s;
+    send_timeout 30s;
+    location /lab/v2/ {
+      proxy_pass http://runtime:8080;
+      proxy_http_version 1.1;
+      proxy_set_header Host "${LAB_PUBLIC_HOST}";
+      proxy_set_header Connection "";
+      proxy_set_header X-Forwarded-Proto https;
+      proxy_buffering off;
+      proxy_request_buffering off;
+      proxy_cache off;
+      proxy_connect_timeout 5s;
+      proxy_read_timeout 3600s; # SSE heartbeat is normally every second
+      proxy_send_timeout 30s;
+      add_header X-Accel-Buffering no always;
+    }
+    location / { return 404; }
+  }
+}
