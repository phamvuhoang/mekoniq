diff --git a/deploy/lab-runtime/Dockerfile b/deploy/lab-runtime/Dockerfile
index 0e26c26..239d6cf 100644
--- a/deploy/lab-runtime/Dockerfile
+++ b/deploy/lab-runtime/Dockerfile
@@ -3,24 +3,28 @@
 ARG BASE=node:24.22.2-bookworm-slim@sha256:01d566e8d94d8c619591d78652babfccd3c6992a3dffa9ed5ab39e11cf6c70e9
 
 FROM ${BASE} AS venv
 RUN apt-get update && apt-get install -y --no-install-recommends python3 python3-venv && rm -rf /var/lib/apt/lists/*
 COPY robotics/simulation-mujoco/requirements.lock /tmp/requirements.lock
 # every package from the lock, by hash, at build time; nothing is installed when the container runs
 RUN python3 -m venv /opt/venv-mujoco && /opt/venv-mujoco/bin/pip install --no-cache-dir --no-compile --only-binary=:all: --require-hashes --no-deps -r /tmp/requirements.lock
 
 FROM ${BASE}
 ARG SOURCE_COMMIT=unknown
+ARG R2B_CAMPAIGN_PACKAGE_SHA256
+ARG R2B_CAMPAIGN_BUNDLE_SHA256
+LABEL org.mekoniq.r2b.campaign-package-sha256="${R2B_CAMPAIGN_PACKAGE_SHA256}" org.mekoniq.r2b.campaign-bundle-sha256="${R2B_CAMPAIGN_BUNDLE_SHA256}"
 LABEL org.opencontainers.image.title="mekoniq-lab-runtime" org.opencontainers.image.revision="${SOURCE_COMMIT}"
 RUN apt-get update && apt-get install -y --no-install-recommends python3 && rm -rf /var/lib/apt/lists/*
 COPY --from=venv /opt/venv-mujoco /opt/venv-mujoco
 COPY runtime.mjs /app/runtime.mjs
+COPY r2b-campaign.mjs r2b-campaign-package.json r2b-engine-inventory.py /app/
 COPY catalog /app/catalog
 # the schemas twice: the exporter's layout (/app/schemas) and the one the worker derives from its root (<root>/../../packages/contracts/schemas)
 COPY schemas /app/schemas
 COPY schemas /app/packages/contracts/schemas
 COPY robotics/simulation-mujoco /app/robotics/simulation-mujoco
 ENV MEKONIQ_LAB_MUJOCO=1 PYTHONDONTWRITEBYTECODE=1 NODE_ENV=production
 RUN mkdir -p /data/runs && chown node:node /data/runs
 USER node
 EXPOSE 8080
 # PORT is read by the runtime (Cloud Run sets it; 8080 otherwise), the access key by the runtime from MEKONIQ_LAB_ACCESS_KEY. The one line of shell only adds a flag
diff --git a/deploy/lab-runtime/build.sh b/deploy/lab-runtime/build.sh
index 3e7dbf9..6ae7258 100755
--- a/deploy/lab-runtime/build.sh
+++ b/deploy/lab-runtime/build.sh
@@ -1,26 +1,35 @@
 #!/bin/sh
-# deploy/lab-runtime/build.sh <tag> [--platform linux/amd64|linux/arm64]
+# deploy/lab-runtime/build.sh <tag> [--platform linux/amd64|linux/arm64] [--oci-out FRESH_DIR]
 # Builds the headless Lab runtime image in a dedicated context. Refuses a dirty tree (no modified or untracked file), so the tracked content of the working tree equals HEAD.
 # runtime.mjs is bundled by scripts/export-lab-runtime.mjs from that clean tree, with the tree's installed node_modules (not a fresh frozen install); the MuJoCo tool root
 # comes from `git archive HEAD`. A from-scratch build from a fresh clone with a frozen install is the Cloud Build path of the deployment runbook. Pushes nothing.
 # Run with Node 24 first on PATH (the exporter bundles with the repository's esbuild).
 set -eu
-tag=${1:?usage: build.sh <tag> [--platform linux/amd64|linux/arm64]}; shift
+tag=${1:?usage: build.sh <tag> [--platform linux/amd64|linux/arm64] [--oci-out FRESH_DIR]}; shift
 platform=
+oci_out=
 if [ "${1:-}" = --platform ]; then platform=${2:?--platform needs a value}; shift 2; fi
+if [ "${1:-}" = --oci-out ]; then oci_out=${2:?--oci-out needs a fresh directory}; shift 2; fi
 [ $# -eq 0 ] || { echo "UNKNOWN_ARGUMENT:$1" >&2; exit 2; }
 case "$platform" in ''|linux/amd64|linux/arm64) ;; *) echo "UNSUPPORTED_PLATFORM:$platform" >&2; exit 2;; esac
 here=$(cd "$(dirname "$0")" && pwd); root=$(cd "$here/../.." && pwd)
 [ -z "$(git -C "$root" status --porcelain --untracked-files=all)" ] || { echo "DIRTY_SOURCE_TREE: commit first, the image's sourceCommit must be a real commit" >&2; exit 1; }
 commit=$(git -C "$root" rev-parse HEAD)
 ctx=$(mktemp -d); trap 'rm -rf "$ctx"' EXIT
 node "$root/scripts/export-lab-runtime.mjs" "$ctx/export" >/dev/null
+node "$root/scripts/build-r2b-campaign.mjs" "$ctx" "$ctx/export"
 mkdir "$ctx/robotics"
 cp "$ctx/export/runtime.mjs" "$ctx/runtime.mjs"; cp -R "$ctx/export/schemas" "$ctx/schemas"; rm -rf "$ctx/export"
 # only the MuJoCo tool root, as committed, without its tests
 git -C "$root" archive HEAD robotics/simulation-mujoco | tar -x -C "$ctx" --exclude 'robotics/simulation-mujoco/tests'
 node "$here/prepare-catalog.mjs" "$ctx/robotics/simulation-mujoco/fixtures/serve-payload-v1/serve-3d-components.json" "$ctx/catalog"
 cp "$here/Dockerfile" "$ctx/Dockerfile"
 printf '%s\n' '**/__pycache__' '**/*.pyc' '**/tests' '**/.git' '**/.env*' > "$ctx/.dockerignore"
-docker build ${platform:+--platform "$platform"} --build-arg "SOURCE_COMMIT=$commit" -t "$tag" "$ctx"
+package_sha=$(shasum -a 256 "$ctx/r2b-campaign-package.json" | cut -d " " -f 1)
+bundle_sha=$(shasum -a 256 "$ctx/r2b-campaign.mjs" | cut -d " " -f 1)
+if [ -n "$oci_out" ]; then
+  node "$root/scripts/native-sim/build-r2b-local-oci.mjs" "$ctx" "$tag" "$platform" "$oci_out"
+else
+docker build ${platform:+--platform "$platform"} --build-arg "SOURCE_COMMIT=$commit" --build-arg "R2B_CAMPAIGN_PACKAGE_SHA256=$package_sha" --build-arg "R2B_CAMPAIGN_BUNDLE_SHA256=$bundle_sha" -t "$tag" "$ctx"
+fi
 echo "built $tag from $commit"
