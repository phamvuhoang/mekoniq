+import {mkdtemp,cp,readFile,writeFile,mkdir} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join,resolve} from 'node:path';import {randomBytes} from 'node:crypto';import {createServer} from 'node:net';import {spawnSync} from 'node:child_process';import {ownedCiConfig} from './owned-ci-config.mjs';
