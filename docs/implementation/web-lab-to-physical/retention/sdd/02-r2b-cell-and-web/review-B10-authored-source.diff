+const source=resolve(import.meta.dirname,'..'),config=await readFile(join(source,'supabase/config.toml'),'utf8'),ports=[...new Set([...config.matchAll(/^\s*port\s*=\s*(\d+)/gm)].map(m=>Number(m[1])))],servers=[];
