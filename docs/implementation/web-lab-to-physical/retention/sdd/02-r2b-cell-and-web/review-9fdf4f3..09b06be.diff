+#!/usr/bin/env node
+// Copy only a digest-admitted retained corpus into a fresh owned directory; the producer files are never opened for write.
+import {readFileSync,mkdirSync,cpSync,writeFileSync} from 'node:fs';import {join,resolve} from 'node:path';import {createHash} from 'node:crypto';import {retainedInput,retainedInventory} from './retained-inputs.mjs';
