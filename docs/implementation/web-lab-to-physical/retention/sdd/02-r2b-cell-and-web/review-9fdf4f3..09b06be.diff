+const env={MEKONIQ_RETAINED_INPUTS:resolve(catalog),MEKONIQ_RETAINED_INPUTS_SHA256:digest},m=JSON.parse(readFileSync(catalog,'utf8')),verified=Object.keys(m.inputs??{}).map(id=>[id,retainedInput(id,env)]);if(!verified.length)throw Error('RETAINED_INPUTS_EMPTY');mkdirSync(out,{mode:0o700});const inputs={};for(const [id,root]of verified){if(!/^[a-z0-9-]+$/.test(id))throw Error('RETAINED_INPUT_ID');cpSync(root,join(out,id),{recursive:true,force:false,errorOnExist:true});retainedInput(id,env);inputs[id]={directory:id,files:retainedInventory(join(out,id)),producer:m.inputs[id].producer??null};if(JSON.stringify(inputs[id].files)!==JSON.stringify(m.inputs[id].files))throw Error('RETAINED_COPY_HASH');}const text=JSON.stringify({version:1,inputs},null,2)+'\n';writeFileSync(join(out,'inputs.json'),text,{flag:'wx',mode:0o600});console.log(JSON.stringify({MEKONIQ_RETAINED_INPUTS:resolve(out,'inputs.json'),MEKONIQ_RETAINED_INPUTS_SHA256:createHash('sha256').update(text).digest('hex')}));
