+ if(pkg.documentProfile!=='mujoco_cell_v1'||! /^[a-f0-9]{64}$/.test(pkg.engineObserverSha256??'')||! /^[a-f0-9]{64}$/.test(pkg.payloadRegistrySha256??'')||! /^[a-f0-9]{64}$/.test(pkg.cellRegistrySha256??''))r.push('R2B_PACKAGE_PROFILE_GRAPH');
