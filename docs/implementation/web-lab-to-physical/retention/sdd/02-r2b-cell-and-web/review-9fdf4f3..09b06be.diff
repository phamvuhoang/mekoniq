+import {dirname,join,resolve,sep} from 'node:path';
+const sha=b=>createHash('sha256').update(b).digest('hex');
+export const safeRetainedPath=p=>typeof p==='string'&&/^[A-Za-z0-9_.-]+(?:\/[A-Za-z0-9_.-]+)*$/.test(p)&&!p.split('/').some(x=>x==='.'||x==='..');
