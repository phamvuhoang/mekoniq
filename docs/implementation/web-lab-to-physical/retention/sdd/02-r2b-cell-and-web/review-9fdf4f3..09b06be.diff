+#!/usr/bin/env node
+// Final prerequisite stage only: creates/stops its own fresh namespace. Never reset/migrate the developer Supabase project.
+import {mkdtemp,cp,readFile,writeFile,mkdir} from 'node:fs/promises';import {tmpdir} from 'node:os';import {join,resolve} from 'node:path';import {randomBytes} from 'node:crypto';import {createServer} from 'node:net';import {spawnSync} from 'node:child_process';import {ownedCiConfig} from './owned-ci-config.mjs';
+const args=process.argv.slice(2);if(args[0]!=='--'||args.length<2)throw Error('USAGE: owned-source-ci.mjs -- COMMAND [ARG...]');
+// Reserve/test every fixed service port before invoking Supabase. Conflict means not_run; no unrelated service is stopped.
+const source=resolve(import.meta.dirname,'..'),config=await readFile(join(source,'supabase/config.toml'),'utf8'),ports=[...new Set([...config.matchAll(/^\s*port\s*=\s*(\d+)/gm)].map(m=>Number(m[1])))],servers=[];
+try{for(const port of ports){const s=createServer();await new Promise((ok,fail)=>{s.once('error',fail);s.listen(port,'127.0.0.1',ok);});servers.push(s);}}finally{for(const s of servers)await new Promise(r=>s.close(r));}
+const work=await mkdtemp(join(tmpdir(),'mekoniq-owned-ci-')),projectId='mekoniq-ci-'+randomBytes(8).toString('hex');await cp(join(source,'supabase'),join(work,'supabase'),{recursive:true,filter:p=>!p.includes('/.temp')&&!p.includes('/.branches')});await writeFile(join(work,'supabase/config.toml'),ownedCiConfig(config,projectId));await mkdir(join(work,'logs'));
+const run=(id,command,args,env=process.env)=>{const startedAt=new Date().toISOString(),r=spawnSync(command,args,{cwd:source,env,encoding:'utf8',timeout:id==='tests'?14400000:300000,maxBuffer:64*1024*1024});return {id,command,args,startedAt,finishedAt:new Date().toISOString(),exitCode:r.status,signal:r.signal,output:(r.stdout??'')+(r.stderr??'')};},save=async r=>{await writeFile(join(work,'logs',r.id+'.log'),r.output,{mode:0o600});await writeFile(join(work,'logs',r.id+'.json'),JSON.stringify({...r,output:undefined}),{mode:0o600});};let exit=2;
+try{const start=run('start','pnpm',['exec','supabase','start','--workdir',work,'-x','studio,imgproxy,edge-runtime,logflare,vector']);await save(start);if(start.exitCode!==0)throw Error('OWNED_SUPABASE_NOT_RUN');const inspect=run('inspect','docker',['inspect','--format','{{.Id}}','supabase_db_'+projectId]);await save(inspect);if(inspect.exitCode!==0||! /^[a-f0-9]{64}$/.test(inspect.output.trim()))throw Error('OWNED_CONTAINER_MISSING');const status=run('status','pnpm',['exec','supabase','status','--workdir',work,'--output','json']);if(status.exitCode!==0)throw Error('OWNED_SUPABASE_STATUS');const creds=JSON.parse(status.output),receipt=join(work,'service-receipt.json');await writeFile(receipt,JSON.stringify({version:1,projectId,containerId:inspect.output.trim(),database:'postgres',host:'127.0.0.1',port:57422,createdForTests:true,unrelatedServicesModified:false}),{mode:0o600});const tests=run('tests',args[1],args.slice(2),{...process.env,MEKONIQ_TEST_SERVICE_RECEIPT:receipt,MEKONIQ_TEST_DB:'postgres',DATABASE_ADMIN_URL:creds.DB_URL,NEXT_PUBLIC_SUPABASE_URL:creds.API_URL,NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY:creds.ANON_KEY,SUPABASE_SERVICE_ROLE_KEY:creds.SERVICE_ROLE_KEY});await save(tests);exit=tests.exitCode??1;}finally{const stop=run('stop','pnpm',['exec','supabase','stop','--workdir',work]);await save(stop);console.log(JSON.stringify({work,projectId,exitCode:exit,stopExitCode:stop.exitCode,accepted:false}));}process.exitCode=exit;
