+ x=Path(ident['export']);old=read(x/'manifest.json');c=L/'.runtime'/old['artifactSha256']
+ assert old==read(c/'manifest.json') and sha((x/'runtime.mjs').read_bytes())==sha((c/'runtime.mjs').read_bytes())==old['artifactSha256']
