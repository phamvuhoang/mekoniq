{
  "name": "@mekoniq/tablet-web",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 3452",
    "build": "npm run check:brand && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "lint": "eslint src vite.config.ts",
    "check:brand": "node ../../scripts/check-brand.mjs --dir ../../packages/ui/brand && node ../../scripts/check-brand.mjs --dir public/brand --against ../../packages/ui/brand/release.json"
  },
  "dependencies": {
    "@capacitor/core": "8.6.0"
  },
  "devDependencies": {
    "vite": "7.3.1"
  }
}
