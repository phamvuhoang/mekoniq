{
  "name": "mekoniq-robot-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4175 --strictPort",
    "build": "pnpm check:brand && tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "playwright test",
    "test": "vitest run",
    "check:source": "node scripts/check-source.mjs",
    "runtime": "node scripts/start-runtime.mjs",
    "test:runtime-e2e": "node scripts/test-runtime-e2e.mjs",
    "test:twin-e2e": "node scripts/test-mock-e2e.mjs twin-workspace.spec.ts coffee-journey.spec.ts twin-recovery.spec.ts",
    "lab:mock": "node scripts/start-mock.mjs",
    "lab:irsim": "node scripts/start-irsim.mjs",
    "lab:webots": "node scripts/start-irsim.mjs --provider webots",
    "lab:mujoco": "node scripts/start-irsim.mjs --provider mujoco",
    "bundle:offline": "node scripts/build-offline.mjs",
    "test:mock-e2e": "node scripts/test-mock-e2e.mjs",
    "test:irsim-e2e": "node scripts/test-irsim-e2e.mjs",
    "test:webots-e2e": "node scripts/test-irsim-e2e.mjs --provider webots",
    "test:mujoco-e2e": "node scripts/test-irsim-e2e.mjs --provider mujoco",
    "check:brand": "node scripts/check-brand.mjs --dir public/brand"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/three": "0.180.0",
    "axe-core": "4.14.0",
    "fake-indexeddb": "6.2.4",
    "typescript": "5.9.3",
    "vite": "7.3.1",
    "vitest": "4.1.12"
  }
}
