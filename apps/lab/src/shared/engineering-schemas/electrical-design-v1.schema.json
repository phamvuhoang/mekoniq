{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.electrical-design.v1",
  "title": "ElectricalDesignV1",
  "description": "One hardware option for one engineering project: which devices, axes, buses, rails and functional signals. Authored by a person; the compiler derives allocation, netlist and checks. No wire runs from pin to pin unless the author pins it.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "electrical-design"
    },
    "id": {
      "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "$ref": "engineering-component.schema.json#/definitions/Digest"
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        }
      },
      "required": [
        "id",
        "revision"
      ]
    },
    "option": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "rationale": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        }
      },
      "required": [
        "id",
        "label",
        "rationale"
      ]
    },
    "devices": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
          },
          "profile": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "digest": {
                "$ref": "engineering-component.schema.json#/definitions/Digest"
              }
            },
            "required": [
              "id",
              "revision",
              "digest"
            ]
          },
          "assemblyInstanceId": {
            "anyOf": [
              {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "id",
          "profile",
          "assemblyInstanceId"
        ]
      }
    },
    "axes": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "axisId": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_-]+/[A-Za-z0-9_.-]+$"
          },
          "driveDeviceId": {
            "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
          },
          "channel": {
            "type": "integer",
            "minimum": 0,
            "maximum": 7
          },
          "motorDeviceId": {
            "anyOf": [
              {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "axisId",
          "driveDeviceId",
          "channel",
          "motorDeviceId"
        ]
      }
    },
    "buses": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
          },
          "protocol": {
            "enum": [
              "canopen",
              "modbus_rtu",
              "ethercat_coe",
              "usb",
              "ethernet",
              "uart"
            ]
          },
          "controllerDeviceId": {
            "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
          },
          "cycleMs": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "members": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "deviceId": {
                  "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                },
                "interfaceId": {
                  "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                },
                "address": {
                  "anyOf": [
                    {
                      "type": "integer",
                      "minimum": 0,
                      "maximum": 255
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "deviceId",
                "interfaceId",
                "address"
              ]
            }
          }
        },
        "required": [
          "id",
          "protocol",
          "controllerDeviceId",
          "cycleMs",
          "members"
        ]
      }
    },
    "power": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "railId": {
            "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
          },
          "nominalV": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "deviceId": {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              "pin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              },
              "returnPin": {
                "type": "string",
                "minLength": 1,
                "maxLength": 80
              }
            },
            "required": [
              "deviceId",
              "pin",
              "returnPin"
            ]
          },
          "feeds": {
            "type": "array",
            "maxItems": 64,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                },
                "to": {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "deviceId": {
                      "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                    },
                    "pin": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    },
                    "returnPin": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 80
                    }
                  },
                  "required": [
                    "deviceId",
                    "pin",
                    "returnPin"
                  ]
                },
                "protectionDeviceId": {
                  "anyOf": [
                    {
                      "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                    },
                    {
                      "type": "null"
                    }
                  ]
                },
                "lengthM": {
                  "anyOf": [
                    {
                      "$ref": "engineering-component.schema.json#/definitions/Scalar"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "to",
                "protectionDeviceId",
                "lengthM"
              ]
            }
          }
        },
        "required": [
          "railId",
          "nominalV",
          "source",
          "feeds"
        ]
      }
    },
    "signals": {
      "type": "array",
      "maxItems": 128,
      "items": {
        "$ref": "#/definitions/SignalV1"
      }
    },
    "stopFunctions": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "$ref": "#/definitions/StopFunctionV1"
      }
    },
    "safetyRequirementsRef": {
      "anyOf": [
        {
          "$ref": "#/definitions/DocumentRef"
        },
        {
          "type": "null"
        }
      ]
    },
    "wiringPolicyRef": {
      "$ref": "#/definitions/DocumentRef"
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "id",
    "revision",
    "digest",
    "project",
    "option",
    "devices",
    "axes",
    "buses",
    "power",
    "signals",
    "stopFunctions",
    "safetyRequirementsRef",
    "wiringPolicyRef"
  ],
  "definitions": {
    "DocumentRef": {
      "title": "DocumentRef",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "id",
        "revision",
        "digest"
      ]
    },
    "SignalV1": {
      "title": "SignalV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "role": {
          "enum": [
            "bumper",
            "cliff",
            "dock_detect",
            "cover_switch",
            "estop_status",
            "charger_present",
            "lamp",
            "buzzer",
            "brake_release",
            "aux_input",
            "aux_output",
            "safety"
          ]
        },
        "direction": {
          "enum": [
            "input",
            "output"
          ]
        },
        "field": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "deviceId": {
              "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
            },
            "pin": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "returnPin": {
              "anyOf": [
                {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "required": [
            "deviceId",
            "pin",
            "returnPin"
          ]
        },
        "electrical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "type": {
              "enum": [
                "pnp_sink_input",
                "npn_source_input",
                "dry_contact_input",
                "pnp_source_output",
                "npn_sink_output",
                "isolated_transistor_output",
                "relay_output",
                "analog_voltage",
                "analog_current"
              ]
            },
            "nominalV": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "currentA": {
              "$ref": "engineering-component.schema.json#/definitions/Scalar"
            }
          },
          "required": [
            "type",
            "nominalV",
            "currentA"
          ]
        },
        "consumer": {
          "enum": [
            "controller",
            "drive_local",
            "safety_chain"
          ]
        },
        "maxLatencyMs": {
          "anyOf": [
            {
              "type": "number",
              "exclusiveMinimum": 0
            },
            {
              "type": "null"
            }
          ]
        },
        "required": {
          "type": "boolean"
        },
        "pinned": {
          "anyOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "deviceId": {
                  "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                },
                "pointId": {
                  "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                }
              },
              "required": [
                "deviceId",
                "pointId"
              ]
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "label",
        "role",
        "direction",
        "field",
        "electrical",
        "consumer",
        "maxLatencyMs",
        "required",
        "pinned"
      ]
    },
    "StopFunctionV1": {
      "title": "StopFunctionV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "normal",
            "protective",
            "emergency"
          ]
        },
        "trigger": {
          "oneOf": [
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "operator"
                }
              },
              "required": [
                "kind"
              ]
            },
            {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "const": "signal"
                },
                "signalId": {
                  "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
                }
              },
              "required": [
                "kind",
                "signalId"
              ]
            }
          ]
        },
        "axes": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "string",
            "minLength": 3,
            "maxLength": 200
          }
        },
        "finalState": {
          "enum": [
            "hold",
            "disabled",
            "torque_off_coast",
            "torque_off_brake"
          ]
        },
        "requirementId": {
          "anyOf": [
            {
              "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "trigger",
        "axes",
        "finalState",
        "requirementId"
      ]
    },
    "WiringPolicyV1": {
      "title": "WiringPolicyV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "documentType": {
          "const": "wiring-policy"
        },
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "ampacity": {
          "type": "array",
          "minItems": 1,
          "maxItems": 16,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "csaMm2": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "maxCurrentA": {
                "$ref": "engineering-component.schema.json#/definitions/Scalar"
              }
            },
            "required": [
              "csaMm2",
              "maxCurrentA"
            ]
          }
        },
        "signalMinCsaMm2": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "maxVoltageDropFraction": {
          "$ref": "engineering-component.schema.json#/definitions/Scalar"
        },
        "copperResistivityOhmMm2PerM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "colours": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "role": {
                "type": "string",
                "minLength": 1,
                "maxLength": 60
              },
              "colour": {
                "type": "string",
                "minLength": 1,
                "maxLength": 40
              }
            },
            "required": [
              "role",
              "colour"
            ]
          }
        },
        "sources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "ampacity": {
              "$ref": "engineering-component.schema.json#/definitions/SourceRef"
            },
            "drop": {
              "$ref": "engineering-component.schema.json#/definitions/SourceRef"
            }
          },
          "required": [
            "ampacity",
            "drop"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "documentType",
        "id",
        "revision",
        "digest",
        "ampacity",
        "signalMinCsaMm2",
        "maxVoltageDropFraction",
        "copperResistivityOhmMm2PerM",
        "colours",
        "sources"
      ]
    }
  }
}
