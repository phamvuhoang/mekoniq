DATABASE_URL=postgresql://mekoniq_app:local_test_only@127.0.0.1:57422/postgres
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:57421
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Backend only; never rename these to NEXT_PUBLIC_*.
SUPABASE_SERVICE_ROLE_KEY=
JOB_HMAC_SECRET=
# W09-W10 integrations (see docs/operations/secrets.md). Backend only.
# Required by the release manifest: >= 32 random chars, wraps channel and webhook secrets.
CHANNEL_SECRET_MASTER=
# Empty = release (only production_approved profiles load). Set to sandbox only on test environments.
INTEGRATION_RUNTIME=
# 1 opens the sandbox online-order page /order/<venueId>; never on production.
CHANNELS_SANDBOX_WEB=
# Public; leave empty until a registered Zalo Mini App exists.
NEXT_PUBLIC_ZALO_APP_ID=
