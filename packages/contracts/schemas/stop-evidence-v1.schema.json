{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.stop-evidence.v1",
  "title": "StopReportV1",
  "description": "What one stop request did to one run, read from the durable evidence of that run. Every number is an observation in an assumed, not calibrated model; the report never states a stopping distance of a robot.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "stop-report"
    },
    "accepted": {
      "const": false
    },
    "calibration": {
      "const": "not_calibrated"
    },
    "digest": {
      "$ref": "engineering-component.schema.json#/definitions/Digest"
    },
    "runId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "function": {
      "enum": [
        "normal",
        "protective",
        "emergency"
      ]
    },
    "entryId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "verdict": {
      "enum": [
        "fired",
        "not_fired"
      ]
    },
    "appliedTick": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1
        },
        {
          "type": "null"
        }
      ]
    },
    "receipt": {
      "anyOf": [
        {
          "$ref": "drive-io-v1.schema.json#/definitions/StopReceiptV1"
        },
        {
          "type": "null"
        }
      ]
    },
    "metrics": {
      "$ref": "#/definitions/StopMetricsV1"
    },
    "drives": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "axisId": {
            "$ref": "drive-io-v1.schema.json#/definitions/DriveAxisId"
          },
          "state": {
            "type": "string",
            "maxLength": 40
          },
          "fault": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 60
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "axisId",
          "state",
          "fault"
        ]
      }
    },
    "invariants": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "enum": [
              "TORQUE_ZERO_AT_EMERGENCY",
              "NO_MOTION_ACCEPTED_AFTER_STOP",
              "NO_AUTO_RESTART",
              "RECEIPT_MATCHES_INTENT",
              "NO_FALSE_SERVE"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "violated",
              "not_applicable",
              "not_evidenced"
            ]
          },
          "detail": {
            "type": "string",
            "maxLength": 500
          }
        },
        "required": [
          "id",
          "result",
          "detail"
        ]
      }
    },
    "decidingParameters": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "value": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "string",
                "maxLength": 200
              },
              {
                "type": "null"
              }
            ]
          },
          "source": {
            "$ref": "engineering-component.schema.json#/definitions/SourceRef"
          }
        },
        "required": [
          "id",
          "value",
          "source"
        ]
      }
    },
    "limits": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "maxLength": 400
      }
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "accepted",
    "calibration",
    "digest",
    "runId",
    "function",
    "entryId",
    "verdict",
    "appliedTick",
    "receipt",
    "metrics",
    "drives",
    "invariants",
    "decidingParameters",
    "limits"
  ],
  "definitions": {
    "Unavailable": {
      "title": "Unavailable",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "unavailable": {
          "enum": [
            "NOT_AT_REST",
            "NOT_APPLICABLE",
            "STREAM_MISSING",
            "TOO_FEW_SAMPLES",
            "RUN_ENDED"
          ]
        }
      },
      "required": [
        "unavailable"
      ]
    },
    "StopMetricsV1": {
      "title": "StopMetricsV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "stopTimeMs": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "stopDistanceM": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "peakDecelerationMps2": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "torqueZeroTick": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "cupMaxSlipMm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "cupTipped": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "postStopDriftMm": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        },
        "wheelSlip": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "$ref": "#/definitions/Unavailable"
            }
          ]
        }
      },
      "required": [
        "stopTimeMs",
        "stopDistanceM",
        "peakDecelerationMps2",
        "torqueZeroTick",
        "cupMaxSlipMm",
        "cupTipped",
        "postStopDriftMm",
        "wheelSlip"
      ]
    },
    "StopPolicyV1": {
      "title": "StopPolicyV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "documentType": {
          "const": "stop-policy"
        },
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "calibration": {
          "const": "not_calibrated"
        },
        "restSpeedMps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "restTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "observeTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 5000
        },
        "decelWindowTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "driftTicks": {
          "type": "integer",
          "minimum": 1,
          "maximum": 1000
        },
        "slipToleranceMps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "cupTiltCosine": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source": {
          "$ref": "engineering-component.schema.json#/definitions/SourceRef"
        }
      },
      "required": [
        "schemaVersion",
        "documentType",
        "id",
        "revision",
        "digest",
        "calibration",
        "restSpeedMps",
        "restTicks",
        "observeTicks",
        "decelWindowTicks",
        "driftTicks",
        "slipToleranceMps",
        "cupTiltCosine",
        "source"
      ]
    },
    "StopOracleV1": {
      "title": "StopOracleV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "documentType": {
          "const": "stop-oracle"
        },
        "id": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "digest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "invariants": {
          "type": "array",
          "minItems": 5,
          "maxItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "enum": [
                  "TORQUE_ZERO_AT_EMERGENCY",
                  "NO_MOTION_ACCEPTED_AFTER_STOP",
                  "NO_AUTO_RESTART",
                  "RECEIPT_MATCHES_INTENT",
                  "NO_FALSE_SERVE"
                ]
              },
              "appliesTo": {
                "type": "array",
                "minItems": 1,
                "maxItems": 3,
                "items": {
                  "enum": [
                    "normal",
                    "protective",
                    "emergency"
                  ]
                }
              }
            },
            "required": [
              "id",
              "appliesTo"
            ]
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "distance": {
              "const": "none"
            },
            "slip": {
              "const": "none"
            }
          },
          "required": [
            "distance",
            "slip"
          ]
        }
      },
      "required": [
        "schemaVersion",
        "documentType",
        "id",
        "revision",
        "digest",
        "invariants",
        "thresholds"
      ]
    }
  }
}
