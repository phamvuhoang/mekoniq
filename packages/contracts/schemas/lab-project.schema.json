{
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "design": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "chassis": {
          "enum": [
            "service",
            "valetudo"
          ]
        },
        "trays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "batteryAh": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        },
        "sensor": {
          "enum": [
            "lidar",
            "depth"
          ]
        },
        "payloadKg": {
          "type": "number",
          "minimum": 0,
          "maximum": 1000
        }
      },
      "required": [
        "id",
        "revision",
        "chassis",
        "trays",
        "batteryAh",
        "sensor",
        "payloadKg"
      ]
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "points": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "table",
                  "kitchen",
                  "parking",
                  "dock"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "x",
              "y"
            ]
          }
        },
        "obstacles": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_-]+$"
              },
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "width",
              "height"
            ]
          }
        }
      },
      "required": [
        "id",
        "revision",
        "width",
        "height",
        "points",
        "obstacles"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "updatedAt",
    "design",
    "world"
  ],
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.lab-project.v1",
  "title": "LabProject"
}
