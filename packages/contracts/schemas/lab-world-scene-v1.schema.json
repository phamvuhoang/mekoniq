{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.lab-world-scene.v1",
  "title": "LabWorldSceneV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "lab-world-scene"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sceneDigest": {
      "$ref": "engineering-component.schema.json#/definitions/Digest"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "armModelDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "mobileModelDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "projectDigest",
        "armModelDigest",
        "mobileModelDigest"
      ]
    },
    "navigation": {
      "$ref": "navigation-scene-v1.schema.json"
    },
    "armCell": {
      "$ref": "arm-cell-scene-v1.schema.json"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "armComponent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "armPhysics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "mobilePhysical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "emptyLoad": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "mobilePhysics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "armComponent",
        "armPhysics",
        "mobilePhysical",
        "emptyLoad",
        "mobilePhysics"
      ]
    },
    "supportMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replacedStaticSupportId": {
          "const": "tray"
        },
        "mobileSupportId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "replacedStaticSupportId",
        "mobileSupportId"
      ]
    },
    "propBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "propId",
          "cupId"
        ]
      }
    },
    "numericalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "coffee-delivery-world-numerics-v1"
        },
        "revision": {
          "const": 1
        },
        "calibration": {
          "const": "not_calibrated"
        },
        "timestepMs": {
          "const": 2
        },
        "substeps": {
          "const": 10
        },
        "primingSubsteps": {
          "const": 10
        },
        "integrator": {
          "const": "implicitfast"
        },
        "cone": {
          "const": "elliptic"
        },
        "impratio": {
          "const": 10
        },
        "solver": {
          "const": "Newton"
        },
        "iterations": {
          "const": 100
        },
        "tolerance": {
          "const": 1e-08
        },
        "floorSlidingFriction": {
          "const": 1.0
        }
      },
      "required": [
        "id",
        "revision",
        "calibration",
        "timestepMs",
        "substeps",
        "primingSubsteps",
        "integrator",
        "cone",
        "impratio",
        "solver",
        "iterations",
        "tolerance",
        "floorSlidingFriction"
      ]
    },
    "handoffPolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "programsRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
          },
          "sha256": {
            "$ref": "engineering-component.schema.json#/definitions/Digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "allowedContactRules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phase": {
            "enum": [
              "grasp",
              "release"
            ]
          },
          "regionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "a",
          "b",
          "phase",
          "regionId"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "id",
    "revision",
    "sceneDigest",
    "inputs",
    "navigation",
    "armCell",
    "models",
    "supportMap",
    "propBindings",
    "numericalPolicy",
    "handoffPolicyRef",
    "programsRef",
    "files",
    "allowedContactRules"
  ]
}
