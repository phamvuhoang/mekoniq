{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.lab-world-scene.v1",
  "title": "LabWorldSceneV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "lab-world-scene"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1
    },
    "sceneDigest": {
      "$ref": "engineering-component.schema.json#/definitions/Digest"
    },
    "inputs": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "projectDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "armModelDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "mobileModelDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "projectDigest",
        "armModelDigest",
        "mobileModelDigest"
      ]
    },
    "navigation": {
      "$ref": "navigation-scene-v1.schema.json"
    },
    "armCell": {
      "$ref": "arm-cell-scene-v1.schema.json"
    },
    "models": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "armComponent": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "armPhysics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "mobilePhysical": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "emptyLoad": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        },
        "mobilePhysics": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "path": {
              "type": "string",
              "maxLength": 240,
              "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
            },
            "sha256": {
              "$ref": "engineering-component.schema.json#/definitions/Digest"
            }
          },
          "required": [
            "path",
            "sha256"
          ]
        }
      },
      "required": [
        "armComponent",
        "armPhysics",
        "mobilePhysical",
        "emptyLoad",
        "mobilePhysics"
      ]
    },
    "supportMap": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replacedStaticSupportId": {
          "const": "tray"
        },
        "mobileSupportId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "replacedStaticSupportId",
        "mobileSupportId"
      ]
    },
    "propBindings": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "propId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "cupId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "propId",
          "cupId"
        ]
      }
    },
    "numericalPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "coffee-delivery-world-numerics-v1"
        },
        "revision": {
          "const": 1
        },
        "calibration": {
          "const": "not_calibrated"
        },
        "timestepMs": {
          "const": 2
        },
        "substeps": {
          "const": 10
        },
        "primingSubsteps": {
          "const": 10
        },
        "integrator": {
          "const": "implicitfast"
        },
        "cone": {
          "const": "elliptic"
        },
        "impratio": {
          "const": 10
        },
        "solver": {
          "const": "Newton"
        },
        "iterations": {
          "const": 100
        },
        "tolerance": {
          "const": 1e-08
        },
        "floorSlidingFriction": {
          "const": 1.0
        }
      },
      "required": [
        "id",
        "revision",
        "calibration",
        "timestepMs",
        "substeps",
        "primingSubsteps",
        "integrator",
        "cone",
        "impratio",
        "solver",
        "iterations",
        "tolerance",
        "floorSlidingFriction"
      ]
    },
    "handoffPolicyRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "programsRef": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "maxLength": 240,
          "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
        },
        "sha256": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        }
      },
      "required": [
        "path",
        "sha256"
      ]
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "maxLength": 240,
            "pattern": "^(?!.*(?:^|/)\\.{1,2}(?:/|$))[A-Za-z0-9_][A-Za-z0-9_.-]*(?:/[A-Za-z0-9_][A-Za-z0-9_.-]*)*$"
          },
          "sha256": {
            "$ref": "engineering-component.schema.json#/definitions/Digest"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100000000
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "allowedContactRules": {
      "type": "array",
      "maxItems": 32,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "a": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "b": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "phase": {
            "enum": [
              "grasp",
              "release"
            ]
          },
          "regionId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          }
        },
        "required": [
          "a",
          "b",
          "phase",
          "regionId"
        ]
      }
    },
    "controllerPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "enum": [
            "grid-diff-world-v1",
            "grid-diff-world-v2",
            "grid-diff-world-v3",
            "grid-diff-world-v4"
          ]
        },
        "version": {
          "enum": [
            "1",
            "2",
            "3",
            "4"
          ]
        },
        "provenance": {
          "const": "assumed"
        },
        "bounds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "minM": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "minimum": -10,
                "maximum": 0
              }
            },
            "maxM": {
              "type": "array",
              "minItems": 2,
              "maxItems": 2,
              "items": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            }
          },
          "required": [
            "minM",
            "maxM"
          ]
        },
        "justification": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "tolerances": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "legM": {
              "const": 0.004
            },
            "positionM": {
              "const": 0.008
            },
            "yawRad": {
              "const": 0.016
            },
            "translationScope": {
              "const": "every_translation"
            }
          },
          "required": [
            "legM",
            "positionM",
            "yawRad",
            "translationScope"
          ]
        },
        "braking": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "designBrakingDecelerationMps2": {
              "const": 0.25
            },
            "settleBeforeTranslationAdvance": {
              "const": true
            }
          },
          "required": [
            "designBrakingDecelerationMps2",
            "settleBeforeTranslationAdvance"
          ]
        },
        "terminalApproachDistanceM": {
          "const": 0.2
        },
        "terminalApproachDirection": {
          "const": "reverse"
        }
      },
      "required": [
        "id",
        "version",
        "provenance",
        "bounds",
        "justification",
        "tolerances"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "id": {
                "const": "grid-diff-world-v1"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "const": "1"
              }
            },
            "required": [],
            "not": {
              "required": [
                "braking"
              ],
              "properties": {
                "braking": {}
              }
            },
            "allOf": [
              {
                "not": {
                  "required": [
                    "terminalApproachDistanceM"
                  ],
                  "properties": {
                    "terminalApproachDistanceM": {}
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "terminalApproachDirection"
                  ],
                  "properties": {
                    "terminalApproachDirection": {}
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "grid-diff-world-v2"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "const": "2"
              },
              "braking": {}
            },
            "required": [
              "braking"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "terminalApproachDistanceM"
                  ],
                  "properties": {
                    "terminalApproachDistanceM": {}
                  }
                }
              },
              {
                "not": {
                  "required": [
                    "terminalApproachDirection"
                  ],
                  "properties": {
                    "terminalApproachDirection": {}
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "grid-diff-world-v3"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "const": "3"
              },
              "braking": {},
              "terminalApproachDistanceM": {}
            },
            "required": [
              "braking",
              "terminalApproachDistanceM"
            ],
            "allOf": [
              {
                "not": {
                  "required": [
                    "terminalApproachDirection"
                  ],
                  "properties": {
                    "terminalApproachDirection": {}
                  }
                }
              }
            ]
          }
        },
        {
          "if": {
            "properties": {
              "id": {
                "const": "grid-diff-world-v4"
              }
            },
            "required": [
              "id"
            ]
          },
          "then": {
            "properties": {
              "version": {
                "const": "4"
              },
              "braking": {},
              "terminalApproachDistanceM": {},
              "terminalApproachDirection": {}
            },
            "required": [
              "braking",
              "terminalApproachDistanceM",
              "terminalApproachDirection"
            ]
          }
        }
      ]
    },
    "disturbance": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "presetId": {
          "enum": [
            "world-dock-drift-v1",
            "world-cup-fall-v1",
            "world-cup-nudge-v1",
            "world-cup-nudge-v2"
          ]
        },
        "revision": {
          "enum": [
            1,
            2
          ]
        },
        "targetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "trigger": {
          "enum": [
            "before_release",
            "transport",
            "after_belief_commit"
          ]
        },
        "cupId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        }
      },
      "required": [
        "presetId",
        "revision",
        "targetId",
        "trigger",
        "cupId"
      ],
      "if": {
        "properties": {
          "presetId": {
            "const": "world-cup-nudge-v2"
          }
        }
      },
      "then": {
        "properties": {
          "revision": {
            "const": 2
          },
          "cupId": {
            "const": "cup-1"
          },
          "trigger": {
            "const": "after_belief_commit"
          }
        }
      },
      "else": {
        "properties": {
          "revision": {
            "const": 1
          }
        }
      }
    },
    "controlContextVersion": {
      "const": 1
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "driveModelRef": {
          "$ref": "drive-io-v1.schema.json#/definitions/DriveDocumentRef"
        },
        "controlProfileRef": {
          "$ref": "drive-io-v1.schema.json#/definitions/DriveDocumentRef"
        }
      },
      "required": []
    }
  },
  "required": [
    "schemaVersion",
    "documentType",
    "id",
    "revision",
    "sceneDigest",
    "inputs",
    "navigation",
    "armCell",
    "models",
    "supportMap",
    "propBindings",
    "numericalPolicy",
    "handoffPolicyRef",
    "programsRef",
    "files",
    "allowedContactRules"
  ]
}
