                      "minItems": 3,
                      "maxItems": 3,
                      "items": {
                        "type": "number"
                      }
                    }
                  },
                  "required": [
                    "name",
                    "massKg",
                    "positionMap"
                  ]
                }
              },
              "wheelRadiusM": {
                "type": "number"
              },
              "wheelSeparationM": {
                "type": "number"
              },
              "wheelAxes": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "array",
                  "minItems": 3,
                  "maxItems": 3,
                  "items": {
                    "type": "number"
                  }
                }
              }
            },
            "required": [
              "robotId",
              "links",
              "wheelRadiusM",
              "wheelSeparationM",
              "wheelAxes"
            ]
          }
        },
        "arm": {
          "type": "object",
          "additionalProperties": false,
          "description": "The arm as the engine loaded it (getState only): link masses and, per joint in chain order, the hinge axis in the parent frame and the motor's position limits.",
          "properties": {
            "links": {
              "type": "array",
              "minItems": 1,
              "maxItems": 9,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "massKg": {
                    "type": "number"
                  }
                },
                "required": [
                  "name",
                  "massKg"
                ]
              }
            },
            "joints": {
              "type": "array",
              "minItems": 1,
              "maxItems": 8,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "properties": {
                  "name": {
                    "type": "string",
                    "minLength": 1,
                    "maxLength": 200
                  },
                  "axis": {
                    "type": "array",
                    "minItems": 3,
                    "maxItems": 3,
                    "items": {
                      "type": "number"
                    }
                  },
                  "lower": {
                    "type": "number"
                  },
                  "upper": {
                    "type": "number"
                  },
                  "forceN": {
                    "type": "number",
                    "description": "The joint actuator's force (torque, N*m for a hinge) limit as the engine loaded it; MuJoCo plant only."
                  }
                },
                "required": [
                  "name",
                  "axis",
                  "lower",
                  "upper"
                ]
              }
            }
          },
          "required": [
