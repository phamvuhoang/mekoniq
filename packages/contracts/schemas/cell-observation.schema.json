{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.cell-observation.v2",
  "title": "CellObservation",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "commandId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "deviceId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "controlEpoch": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "payloadHash": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "bootId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "seq": {
      "type": "string",
      "pattern": "^[0-9]{1,20}$"
    },
    "result": {
      "enum": [
        "accepted",
        "completed",
        "failed",
        "rejected",
        "outcome_unknown"
      ]
    },
    "observedAt": {
      "anyOf": [
        {
          "type": "string",
          "format": "date-time"
        },
        {
          "type": "null"
        }
      ]
    },
    "reasonCodes": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 100,
        "pattern": "^[A-Z][A-Z0-9_]*$"
      }
    },
    "recipeRevision": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ],
      "description": "Recipe revision the device executed, when it can state it; must equal the job's frozen revision."
    }
  },
  "required": [
    "schemaVersion",
    "commandId",
    "deviceId",
    "controlEpoch",
    "payloadHash",
    "bootId",
    "seq",
    "result",
    "observedAt",
    "reasonCodes"
  ]
}
