{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.engineering-project-archive.v1",
  "title": "EngineeringArchive",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "documentType": {
      "const": "engineering-project-archive"
    },
    "schemaVersion": {
      "const": 1
    },
    "project": {
      "$ref": "engineering-project.schema.json"
    },
    "components": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "$ref": "engineering-component.schema.json"
      }
    },
    "assets": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "$ref": "asset-revision.schema.json"
      }
    },
    "recipes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "$ref": "coffee-recipe.schema.json"
      }
    },
    "migration": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "report": {
          "type": "object"
        },
        "original": {
          "type": "object"
        }
      },
      "required": [
        "report",
        "original"
      ]
    },
    "blobs": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "digest": {
            "$ref": "engineering-component.schema.json#/definitions/Digest"
          },
          "file": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^(?!.*\\.\\.)(?!/)[A-Za-z0-9._/-]+$"
          },
          "mediaType": {
            "type": "string",
            "minLength": 1,
            "maxLength": 100
          },
          "license": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "sizeBytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 209715200
          }
        },
        "required": [
          "digest",
          "file",
          "mediaType",
          "license",
          "sizeBytes"
        ]
      }
    },
    "missingDigests": {
      "type": "array",
      "maxItems": 5000,
      "items": {
        "$ref": "engineering-component.schema.json#/definitions/Digest"
      }
    }
  },
  "required": [
    "documentType",
    "schemaVersion",
    "project",
    "components",
    "assets",
    "recipes",
    "blobs",
    "missingDigests"
  ]
}
