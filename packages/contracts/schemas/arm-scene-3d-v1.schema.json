{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.arm-scene-3d.v1",
  "title": "ArmScene3DV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "sceneDigest": {
      "$ref": "engineering-component.schema.json#/definitions/Digest"
    },
    "arm": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "armId": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "modelId": {
          "const": "arm-ref-3d-v1"
        },
        "modelRevision": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "baseInMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number"
              }
            },
            "quaternionXyzw": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number"
              }
            }
          },
          "required": [
            "position",
            "quaternionXyzw"
          ]
        },
        "homeRad": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "number"
          }
        }
      },
      "required": [
        "armId",
        "modelId",
        "modelRevision",
        "baseInMap",
        "homeRad"
      ]
    },
    "statics": {
      "type": "array",
      "minItems": 0,
      "maxItems": 64,
      "items": {
        "oneOf": [
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              "kind": {
                "const": "sphere"
              },
              "center": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "radiusM": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "kind",
              "center",
              "radiusM"
            ]
          },
          {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              "kind": {
                "const": "box"
              },
              "min": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "max": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              }
            },
            "required": [
              "id",
              "kind",
              "min",
              "max"
            ]
          }
        ]
      }
    },
    "world3d": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "floorFriction": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "provenance": {
          "const": "assumed"
        }
      },
      "required": [
        "floorFriction",
        "provenance"
      ]
    },
    "engine": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "const": "webots_3d"
        },
        "basicTimeStepMs": {
          "const": 20
        }
      },
      "required": [
        "id",
        "basicTimeStepMs"
      ]
    },
    "engineSeed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 2147483647
    }
  },
  "required": [
    "schemaVersion",
    "sceneDigest",
    "arm",
    "statics",
    "world3d",
    "engine",
    "engineSeed"
  ]
}
