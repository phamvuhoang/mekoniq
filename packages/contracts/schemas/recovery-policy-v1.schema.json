{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.recovery-policy.v1",
  "title": "RecoveryPolicyV1",
  "type": "object",
  "additionalProperties": false,
  "description": "A bounded recovery table for a failed pick (R4-D27): rules over a closed catalogue of triggers, facts and steps, each with a maximum number of attempts. Every value is assumed. Not a behaviour tree.",
  "required": [
    "schemaVersion",
    "documentType",
    "id",
    "revision",
    "digest",
    "calibration",
    "parameterSource",
    "beliefWaitTicks",
    "rules"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "documentType": {
      "const": "recovery-policy"
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "digest": {
      "$ref": "engineering-component.schema.json#/definitions/Digest"
    },
    "calibration": {
      "const": "not_calibrated"
    },
    "parameterSource": {
      "const": "assumed"
    },
    "beliefWaitTicks": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1000
    },
    "rules": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "on",
          "requires",
          "steps",
          "maxAttempts"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 64
          },
          "on": {
            "type": "array",
            "minItems": 1,
            "maxItems": 3,
            "uniqueItems": true,
            "items": {
              "enum": [
                "GRIP_NOT_ESTABLISHED",
                "BELIEF_UNAVAILABLE",
                "BELIEF_STALE"
              ]
            }
          },
          "requires": {
            "type": "array",
            "maxItems": 4,
            "uniqueItems": true,
            "items": {
              "enum": [
                "arm_state_fresh",
                "no_unknown_command",
                "cup_on_declared_support",
                "cup_not_between_pads"
              ]
            }
          },
          "steps": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "items": {
              "enum": [
                "open_gripper",
                "retreat_pick_approach",
                "await_fresh_belief",
                "retry_pick"
              ]
            }
          },
          "maxAttempts": {
            "type": "integer",
            "minimum": 1,
            "maximum": 3
          }
        }
      }
    }
  }
}
