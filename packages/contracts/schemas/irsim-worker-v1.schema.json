  "definitions": {
    "LidarScanV1": {
      "title": "LidarScanV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sensorId": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "frameId": {
          "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "simTimeNs": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "angleMinRad": {
          "type": "number"
        },
        "angleIncrementRad": {
          "type": "number"
        },
        "rangeMinM": {
          "type": "number",
          "minimum": 0
        },
        "rangeMaxM": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "rangesM": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1080,
          "items": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "states": {
          "type": "array",
          "minItems": 0,
          "maxItems": 1080,
          "items": {
            "enum": [
              "hit",
              "no_return",
              "below_min",
              "invalid"
            ]
          }
        }
      },
      "required": [
        "sensorId",
        "frameId",
        "tick",
        "simTimeNs",
        "angleMinRad",
        "angleIncrementRad",
        "rangeMinM",
        "rangeMaxM",
        "rangesM",
        "states"
      ]
    },
    "IRSimSnapshotV1": {
      "title": "IRSimSnapshotV1",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "runId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "bootId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "tick": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "simTimeNs": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "seq": {
          "type": "string",
          "pattern": "^[0-9]+$"
        },
        "sceneDigest": {
          "$ref": "engineering-component.schema.json#/definitions/Digest"
        },
        "robots": {
          "type": "array",
          "minItems": 0,
          "maxItems": 2,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "robotId": {
                "$ref": "engineering-component.schema.json#/definitions/EngineeringId"
              },
              "poseDriveMap": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "bodyVelocity": {
                "type": "array",
                "minItems": 2,
                "maxItems": 2,
                "items": {
                  "type": "number"
                }
              },
              "scans": {
                "type": "array",
                "minItems": 0,
                "maxItems": 16,
                "items": {
                  "$ref": "#/definitions/LidarScanV1"
                }
              },
              "collisionIds": {
                "type": "array",
                "minItems": 0,
                "maxItems": 64,
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                }
              }
            },
            "required": [
              "robotId",
              "poseDriveMap",
              "bodyVelocity",
              "scans",
              "collisionIds"
            ]
          }
        }
      },
      "required": [
        "schemaVersion",
        "runId",
        "bootId",
        "tick",
        "simTimeNs",
        "seq",
        "sceneDigest",
        "robots"
      ]
    },
    "IRSimResponseV1": {
      "title": "IRSimResponseV1",
      "type": "object",
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "protocol": {
              "const": "mekoniq-irsim/1"
            },
