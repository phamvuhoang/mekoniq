            },
            "runId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "bootId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ok": {
              "const": false
            },
            "error": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "code": {
                  "type": "string",
                  "minLength": 1,
