                    },
                    "ops": {
                      "type": "array",
                      "minItems": 0,
                      "maxItems": 16,
                      "items": {
                        "type": "string",
                        "minLength": 1,
                        "maxLength": 200
                      }
                    }
                  },
                  "required": [
                    "packageVersion",
                    "pythonVersion",
                    "lockDigest",
                    "ops"
                  ]
                }
              ]
            }
          },
          "required": [
            "protocol",
            "requestId",
            "runId",
            "bootId",
            "tick",
            "ok",
            "result"
          ]
        },
