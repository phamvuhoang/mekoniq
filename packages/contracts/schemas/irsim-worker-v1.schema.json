              "maxLength": 200
            },
            "bootId": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "tick": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "ok": {
              "const": true
            },
            "result": {
              "anyOf": [
                {
                  "$ref": "#/definitions/IRSimSnapshotV1"
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "state": {
                      "enum": [
                        "created",
                        "running",
                        "paused",
                        "stopped",
                        "failed"
                      ]
                    }
                  },
                  "required": [
                    "state"
                  ]
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "properties": {
                    "packageVersion": {
                      "type": "string",
                      "minLength": 1,
                      "maxLength": 200
                    },
