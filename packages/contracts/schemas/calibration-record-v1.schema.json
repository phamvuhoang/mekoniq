{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.calibration-record.v1",
  "title": "CalibrationRecordV1",
  "description": "The outcome of one identification run (R4-C, V15): which parameters were fitted from which dataset within which declared bounds, how the fit ended, how it did on the held-out validation split, and which new model revisions it produced. A record that did not pass, touched a bound, did not converge, could not separate its parameters, or came from synthetic data / the tool self-test produces nothing. Always accepted:false.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "documentType", "digest", "planDigest", "datasetDigest", "configDigest", "baseDriveModelDigest", "fitDigest", "sourceKind", "fitted", "convergence", "validation", "domain", "produced", "reasonCodes", "toolSelfTest", "accepted"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "documentType": { "const": "calibration-record" },
    "digest": { "$ref": "engineering-component.schema.json#/definitions/Digest" },
    "planDigest": { "$ref": "engineering-component.schema.json#/definitions/Digest" },
    "datasetDigest": { "$ref": "engineering-component.schema.json#/definitions/Digest" },
    "configDigest": { "$ref": "engineering-component.schema.json#/definitions/Digest" },
    "baseDriveModelDigest": { "$ref": "engineering-component.schema.json#/definitions/Digest" },
    "fitDigest": { "$ref": "engineering-component.schema.json#/definitions/Digest" },
    "sourceKind": { "enum": ["measured", "synthetic"] },
    "fitted": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "value", "atBound", "unit", "standardError"],
        "properties": {
          "path": { "type": "string", "pattern": "^[A-Za-z0-9_.\\[\\]-]{1,120}$" },
          "value": { "type": "number" },
          "atBound": { "type": "boolean" },
          "unit": { "type": "string", "minLength": 1, "maxLength": 20 },
          "standardError": { "type": ["number", "null"], "minimum": 0 }
        }
      }
    },
    "convergence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["iterations", "converged", "objectiveInitial", "objectiveFinal", "jacobianCondition"],
      "properties": {
        "iterations": { "type": "integer", "minimum": 0 },
        "converged": { "type": "boolean" },
        "objectiveInitial": { "type": "number", "minimum": 0 },
        "objectiveFinal": { "type": "number", "minimum": 0 },
        "jacobianCondition": { "type": ["number", "null"], "minimum": 1, "description": "null: the Jacobian is singular (unbounded condition number); JSON cannot carry Infinity." }
      }
    },
    "validation": { "$ref": "engineering-calibration.schema.json#/definitions/CalibrationResult" },
    "domain": {
      "type": "object",
      "maxProperties": 50,
      "propertyNames": { "pattern": "^[A-Za-z0-9_.:/-]{1,100}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["min", "max"],
        "properties": { "min": { "type": "number" }, "max": { "type": "number" } }
      }
    },
    "produced": {
      "type": "array",
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["document", "id", "revision", "digest"],
        "properties": {
          "document": { "enum": ["drive_model", "arm_physics"] },
          "id": { "type": "string", "minLength": 1, "maxLength": 200 },
          "revision": { "type": "integer", "minimum": 1 },
          "digest": { "$ref": "engineering-component.schema.json#/definitions/Digest" }
        }
      }
    },
    "reasonCodes": {
      "type": "array",
      "uniqueItems": true,
      "items": { "enum": ["SYNTHETIC_DATA", "TOOL_SELF_TEST", "NOT_CONVERGED", "PARAMETER_AT_BOUND", "IDENTIFIABILITY_POOR", "VALIDATION_FAILED", "CONFIG_DIGEST_MISMATCH", "PREDICTION_FAILED"] }
    },
    "toolSelfTest": { "type": "boolean" },
    "accepted": { "const": false }
  },
  "allOf": [
    { "if": { "properties": { "toolSelfTest": { "const": true } }, "required": ["toolSelfTest"] }, "then": { "properties": { "produced": { "type": "array", "maxItems": 0 }, "sourceKind": { "const": "synthetic" } } } },
    { "if": { "properties": { "sourceKind": { "const": "synthetic" } }, "required": ["sourceKind"] }, "then": { "properties": { "produced": { "type": "array", "maxItems": 0 } } } },
    { "if": { "properties": { "fitted": { "type": "array", "contains": { "type": "object", "properties": { "atBound": { "const": true } }, "required": ["atBound"] } } }, "required": ["fitted"] }, "then": { "properties": { "produced": { "type": "array", "maxItems": 0 } } } },
    { "if": { "properties": { "convergence": { "type": "object", "properties": { "converged": { "const": false } }, "required": ["converged"] } }, "required": ["convergence"] }, "then": { "properties": { "produced": { "type": "array", "maxItems": 0 } } } },
    { "if": { "properties": { "validation": { "type": "object", "properties": { "status": { "enum": ["fail", "not_run"] } }, "required": ["status"] } }, "required": ["validation"] }, "then": { "properties": { "produced": { "type": "array", "maxItems": 0 } } } }
  ]
}
