{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.lab-run.v2",
  "title": "LabRunSnapshotV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "format": "uuid"
    },
    "mode": {
      "enum": [
        "mock",
        "simulation",
        "hardware"
      ]
    },
    "access": {
      "enum": [
        "simulated",
        "shadow",
        "hil",
        "live"
      ]
    },
    "backendSetId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "backends": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 200,
        "pattern": "^[A-Za-z0-9_.:-]+$"
      }
    },
    "status": {
      "enum": [
        "ready",
        "running",
        "paused",
        "awaiting_confirmation",
        "completed",
        "cancelled",
        "needs_attention"
      ]
    },
    "runRevision": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "eventCursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "telemetryCursor": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{1,20}$"
        },
        {
          "type": "null"
        }
      ]
    },
    "fidelity": {
      "enum": [
        "business",
        "modeled",
        "physics_sim",
        "hardware"
      ]
    },
    "ageMs": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "sourceCommit": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "scenarioId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "scenarioRevision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "maximum": 4294967295
    },
    "faultScheduleHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "mode",
    "access",
    "backendSetId",
    "backends",
    "status",
    "runRevision",
    "eventCursor",
    "telemetryCursor",
    "fidelity",
    "ageMs",
    "sourceCommit",
    "scenarioId",
    "scenarioRevision",
    "seed"
  ],
  "definitions": {
    "CreateRunRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "project": {
          "type": "object"
        },
        "scenarioId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "scenarioRevision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "seed": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4294967295
        },
        "mode": {
          "enum": [
            "mock",
            "simulation",
            "hardware"
          ]
        },
        "backendSetId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "access": {
          "enum": [
            "simulated",
            "shadow",
            "hil",
            "live"
          ]
        },
        "runtimeIdentity": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "sourceCommit": {
              "type": "string",
              "minLength": 1,
              "maxLength": 200
            },
            "schemaHash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            }
          },
          "required": [
            "sourceCommit",
            "schemaHash"
          ]
        }
      },
      "required": [
        "project",
        "scenarioId",
        "scenarioRevision",
        "seed",
        "mode",
        "backendSetId",
        "access",
        "runtimeIdentity"
      ]
    }
  }
}
