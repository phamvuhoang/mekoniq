{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.lab-project.v2",
  "title": "LabProjectV2",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 2
    },
    "id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9_.:-]+$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "entities": {
      "type": "array",
      "maxItems": 200,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200,
            "pattern": "^[A-Za-z0-9_.:-]+$"
          },
          "kind": {
            "enum": [
              "amr",
              "arm",
              "coffee_machine",
              "cup_station"
            ]
          },
          "assetRef": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "revision": {
                "type": "integer",
                "minimum": 1,
                "maximum": 9007199254740991
              },
              "contentHash": {
                "type": "string",
                "pattern": "^[0-9a-f]{64}$"
              }
            },
            "required": [
              "id",
              "revision",
              "contentHash"
            ]
          },
          "recipeRefs": {
            "type": "array",
            "maxItems": 50,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200,
                  "pattern": "^[A-Za-z0-9_.:-]+$"
                },
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 9007199254740991
                },
                "hash": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                }
              },
              "required": [
                "id",
                "revision",
                "hash"
              ]
            }
          },
          "speedLimitMps": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 0.5,
            "description": "Illustrative mock AMR speed limit in metres per second; fixed run input."
          }
        },
        "required": [
          "id",
          "kind",
          "assetRef"
        ]
      }
    },
    "world": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "height": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000
        },
        "points": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "table",
                  "kitchen",
                  "parking",
                  "dock",
                  "coffee_pickup"
                ]
              },
              "x": {
                "type": "number"
              },
              "y": {
                "type": "number"
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "x",
              "y"
            ]
          }
        },
        "handoffPoints": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "name": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              },
              "kind": {
                "enum": [
                  "table",
                  "kitchen",
                  "parking",
                  "dock",
                  "coffee_pickup"
                ]
              },
              "position": {
                "type": "array",
                "minItems": 3,
                "maxItems": 3,
                "items": {
                  "type": "number"
                }
              },
              "yawRad": {
                "anyOf": [
                  {
                    "type": "number"
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "id",
              "name",
              "kind",
              "position",
              "yawRad"
            ]
          }
        },
        "obstacles": {
          "type": "array",
          "maxItems": 200,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200,
                "pattern": "^[A-Za-z0-9_.:-]+$"
              },
              "x": {
                "type": "number",
                "minimum": 0
              },
              "y": {
                "type": "number",
                "minimum": 0
              },
              "width": {
                "type": "number",
                "exclusiveMinimum": 0
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0
              }
            },
            "required": [
              "id",
              "x",
              "y",
              "width",
              "height"
            ]
          }
        }
      },
      "required": [
        "id",
        "revision",
        "width",
        "height",
        "points",
        "obstacles"
      ]
    },
    "armCollisionProfile": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schemaVersion": {
          "const": 1
        },
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "revision": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "units": {
          "const": "SI"
        },
        "provenance": {
          "const": "illustrative"
        },
        "reference": {
          "type": "string",
          "minLength": 1,
          "maxLength": 1000
        },
        "modelId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^[A-Za-z0-9_.:-]+$"
        },
        "modelRevision": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "baseInMap": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "position": {
              "type": "array",
              "minItems": 3,
              "maxItems": 3,
              "items": {
                "type": "number",
                "minimum": -1000,
                "maximum": 1000
              }
            },
            "quaternionXyzw": {
              "type": "array",
              "minItems": 4,
              "maxItems": 4,
              "items": {
                "type": "number",
                "minimum": -1,
                "maximum": 1
              }
            }
          },
          "required": [
            "position",
            "quaternionXyzw"
          ]
        },
        "fixtureHeightM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        },
        "robotHeightM": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 100
        }
      },
      "required": [
        "schemaVersion",
        "id",
        "revision",
        "units",
        "provenance",
        "reference",
        "modelId",
        "modelRevision",
        "baseInMap",
        "fixtureHeightM",
        "robotHeightM"
      ],
      "description": "Optional illustrative arm scene: SI map-from-base pose, normalized xyzw quaternion, and explicit vertical extrusions above map z=0. No calibrated or physical collision claim."
    },
    "faultSchedule": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "$ref": "lab-fault-schedule.schema.json"
      }
    }
  },
  "required": [
    "schemaVersion",
    "id",
    "name",
    "revision",
    "updatedAt",
    "entities",
    "world"
  ]
}
