{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.lab-run-verification.v1",
  "title": "RunVerification",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "execution": {
      "enum": [
        "not_run",
        "ran"
      ]
    },
    "result": {
      "enum": [
        "pass",
        "fail",
        "not_run"
      ]
    },
    "blockers": {
      "type": "array",
      "maxItems": 1000,
      "items": {
        "type": "string",
        "maxLength": 1000
      }
    },
    "target": {
      "enum": [
        "mac-mock",
        "linux-vm-sim",
        "linux-amd64-sim"
      ]
    },
    "aspects": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "producer": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "fidelity": {
            "enum": [
              "mock",
              "controller_sim",
              "physics_sim",
              "modeled"
            ]
          },
          "artifactSha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          }
        },
        "required": [
          "name",
          "producer",
          "fidelity",
          "artifactSha256"
        ]
      }
    },
    "arm": {
      "anyOf": [
        {
          "$ref": "lab-arm-collision-evidence.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "transfers": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "$ref": "lab-transfer-evidence.schema.json"
      }
    },
    "artifacts": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500,
            "pattern": "^[A-Za-z0-9_-][A-Za-z0-9_./-]*$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "bytes": {
            "type": "integer",
            "minimum": 0,
            "maximum": 67108864
          }
        },
        "required": [
          "path",
          "sha256",
          "bytes"
        ]
      }
    },
    "armTickMap": {
      "type": "array",
      "maxItems": 10000,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sampleTick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "runTick": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "entityId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "bootId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "seq": {
            "type": "string",
            "pattern": "^[0-9]{1,20}$"
          }
        },
        "required": [
          "sampleTick",
          "runTick"
        ]
      }
    }
  },
  "required": [
    "schemaVersion",
    "execution",
    "result",
    "blockers",
    "target",
    "aspects",
    "arm",
    "transfers",
    "artifacts"
  ]
}
