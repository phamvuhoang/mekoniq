{
  "name": "mekoniq-platform",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev:cloud": "pnpm --filter @mekoniq/cloud-web dev",
    "dev:tablet": "pnpm --filter @mekoniq/tablet-web dev",
    "build": "pnpm -r --if-present build",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "doctor": "node scripts/doctor.mjs",
    "local:bootstrap": "node scripts/bootstrap-local.mjs",
    "supabase:start": "node scripts/supabase-local.mjs start",
    "supabase:stop": "node scripts/supabase-local.mjs stop",
    "contracts:generate": "node scripts/generate-contracts.mjs",
    "contracts:check": "node scripts/generate-contracts.mjs --check",
    "test:unit": "node scripts/test-runner.mjs unit",
    "test:contracts": "node scripts/test-runner.mjs contracts",
    "test:integration": "node scripts/test-runner.mjs integration",
    "test:e2e": "node scripts/test-runner.mjs e2e",
    "test:security": "node scripts/test-runner.mjs security",
    "test:acceptance": "node scripts/test-runner.mjs acceptance",
    "test:android": "node scripts/android-lab.mjs",
    "test": "pnpm test:unit && pnpm test:contracts && pnpm test:integration",
    "jobs:run": "node scripts/run-jobs.mjs",
    "cloud:budget": "node scripts/report-cloud-budget.mjs",
    "dev:coordinator": "node scripts/dev-coordinator.mjs",
    "test:adapters": "node scripts/test-runner.mjs adapters",
    "test:providers": "node scripts/test-runner.mjs providers",
    "test:load": "node scripts/test-runner.mjs load"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "fast-check": "4.10.2",
    "json-schema-to-typescript": "16.0.0",
    "supabase": "2.118.0",
    "tsx": "4.22.4",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "@supabase/supabase-js": "2.118.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "json-canonicalize": "3.0.1",
    "postgres": "3.4.8"
  }
}
