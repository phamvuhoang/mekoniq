{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "mekoniq.bench-wire.v1",
  "title": "BenchWireV1",
  "definitions": {
    "BenchRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "protocol": {
          "const": "mekoniq-bench/1"
        },
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "sessionId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "expectedTick": {
          "type": "integer",
          "minimum": 0
        },
        "op": {
          "enum": [
            "describe",
            "open",
            "scan",
            "configure",
            "start",
            "step",
            "silence",
            "imuConfigure",
            "stop"
          ]
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "protocol",
        "requestId",
        "sessionId",
        "expectedTick",
        "op",
        "payload"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "op": {
                "const": "step"
              }
            },
            "required": [
              "op"
            ]
          },
          "then": {
            "properties": {
              "payload": {
                "type": "object",
                "properties": {
                  "commands": {
                    "type": "array",
                    "items": {
                      "$ref": "mekoniq.drive-io.v1#/definitions/DriveCommandV1"
                    }
                  }
                },
                "required": [
                  "commands"
                ]
              }
            }
          }
        }
      ]
    },
    "BenchResponse": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "requestId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "ok": {
          "type": "boolean"
        },
        "tick": {
          "type": "integer",
          "minimum": 0
        },
        "result": {
          "type": "object"
        },
        "error": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "code": {
              "type": "string",
              "pattern": "^(BENCH|WORKER|DRIVE)_[A-Z0-9_]+$"
            },
            "detail": {
              "type": "string"
            }
          },
          "required": [
            "code",
            "detail"
          ]
        }
      },
      "required": [
        "requestId",
        "ok",
        "tick"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "ok": {
                "const": false
              }
            },
            "required": [
              "ok"
            ]
          },
          "then": {
            "properties": {
              "error": {
                "type": "object"
              }
            },
            "required": [
              "error"
            ]
          }
        }
      ]
    }
  }
}
